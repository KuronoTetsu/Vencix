# Copie este arquivo para .env e preencha com valores reais (nunca commitar o .env)

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
JWT_SECRET_KEY=troque-por-outra-chave-aleatoria-diferente

DATABASE_URL=postgresql://vencix_user:senha_forte@localhost:5432/vencix_db

# Origens permitidas no CORS (separadas por vírgula) — coloque a URL do seu frontend
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Ativa o debugger do Werkzeug — APENAS em desenvolvimento local. NUNCA em produção.
# Em produção, mantenha FLASK_DEBUG=0 (ou remova a linha).
FLASK_DEBUG=0

# --- Rate Limiting (Flask-Limiter) ---
# Em desenvolvimento: memory:// (simples, sem dependências extras).
# Em PRODUÇÃO: use Redis para que os contadores funcionem com múltiplos workers
# do Gunicorn e sobrevivam a restarts do servidor.
# Instale Redis no servidor e ajuste host/porta abaixo.
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
